# dhcp-snooping-82 configuration, every key with its default.
#
# "install" copies this file to /etc/persistent/dhcp-snooping-82/ as
# dhcp-snooping-82.conf.example (always, as a reference for the installed
# version) and as dhcp-snooping-82.conf (only if there is none yet, so local
# settings survive updates). The agent reads only dhcp-snooping-82.conf.
# All keys are optional: a file with just
#   [source_guard]
#   enable = yes
# changes only that. Changes take effect on SIGHUP (killall -HUP dhcp-fwd).

[interface]
# Explicit ports, as a vendor UI would pass them with -u/-t. If any is
# given, exactly these ports are used and everything below (system.cfg,
# name based classification) is ignored. Repeat the key or list ports.
#untrusted = br1:eth0     # customer port: add option 82, block DHCP servers
#trusted = br1:ath0.1284  # uplink towards the DHCP server
#
# Without explicit ports:
# Bridges: "auto" = every bridge with DHCP relay (option 82) enabled in
# /tmp/system.cfg (dhcprelay.client.N.devname), or a list like "br1, br2".
bridges = auto
# Ports of those bridges are classified by the physical device below any
# VLAN (ath0.1284 -> ath0): eth* = untrusted client port, ath* = uplink.
# "auto" or an explicit list overrides the classification.
clients = auto
uplinks = auto
client_prefix = eth
uplink_prefix = ath
mtu = 1500               # max IP length after inserting option 82

[option82]
# %h hostname (resolv.host.1.name), %b bridge, %p port,
# %m bridge MAC, %M port MAC (MACs as 12 hex digits), %% percent
circuit_id = %h/%b:%p    # e.g. cust-example/br1:eth0
remote_id = %m           # "none" omits sub-option 2
# message types that get option 82 (bootp = no option 53)
types = discover, request, decline, release, inform, bootp
# request from the customer already carries option 82 / giaddr / hops:
# forward = pass unchanged (never overwritten), drop = discard
existing_option82 = forward

[reply]
foreign_option82 = drop  # reply with someone else's option 82
without_option82 = forward

[snooping]
# replaces the airOS FIREWALL rules "Rogue DHCP-Server"/"Disallow DHCP Requests"
block_client_servers = true   # DHCP server replies arriving on the client port
block_uplink_requests = true  # other customers' DHCP requests from the uplink

[dhcpv6]
# Lightweight DHCPv6 Relay Agent (RFC 6221), the IPv6 counterpart of
# option 82: client messages from untrusted ports are wrapped into a
# Relay-Forward with Interface-ID and Remote-ID, Relay-Replies are unwrapped
# and sent only to the port their Interface-ID names. Prefix delegation
# (IA_PD) passes through unchanged. Snooping as above: Relay-Forward and
# server messages from customers and other customers' messages from the
# uplink are dropped. On the command line also as dhcpv6.snooping=yes.
snooping = yes
# drop router advertisements arriving on untrusted ports (dhcpv6.RAguard=yes).
# Kernel 2.6.32 cannot match ICMPv6 types in ebtables, so all link-local
# ICMPv6 of these ports goes through the agent, which passes all but RAs on.
ra_guard = yes
interface_id =           # template, empty = same as option82 circuit_id
remote_id =              # template, empty = same as option82 remote_id
enterprise = 41112       # enterprise number in the Remote-ID option
unicast = relay          # unicast client messages: relay | forward unchanged

[source_guard]
# IP source guard and ARP inspection on untrusted ports: only the addresses
# the DHCP server handed out (DHCPACK, DHCPv6 Reply with IA_NA/IA_PD) may be
# used, bound to the client's MAC; all other IPv4, ARP and IPv6 from these
# ports is dropped. A renew only extends the lease internally, the rules
# change only when a lease appears, expires, is released or NAKed.
# On the command line e.g. source_guard.enable=yes source_guard.grace=600
enable = no
ipv6 = yes               # also IPv6 (needs dhcpv6 snooping = yes)
block_ip_only = yes      # no: also drop PPPoE and every other non-IP frame
# seconds after the start in which bindings are only learned, not enforced.
# 0: block at once. A station reboot flaps the customer's link and the router
# asks again; with a switch in between it may not, then a grace period helps.
grace = 0
max_bindings = 16        # per port
lease_file = /var/run/dhcp-snooping-82.leases   # RAM, survives agent restarts

[forwarding]
rate_limit = 20          # DHCP frames/s per port, 0 = unlimited
rate_burst = 50
rule_check_interval = 5  # seconds; airOS flushes ebtables on every "Apply"
keep_rules_on_stop = false
ebtables = /sbin/ebtables

[rollback]
# roll back to the original if requests we marked stay unanswered
enabled = false
window = 600
min_requests = 5
command = /etc/persistent/dhcp-snooping-82/dhcp-snooping-82.sh rollback

[logging]
level = info             # error | warn | info | debug
stats_file = /var/run/dhcp-snooping-82.stats
stats_interval = 10

[system]
pidfile = /var/run/dhcp-fwd.pid
system_cfg = /tmp/system.cfg
worker_uid = 99          # packet worker runs unprivileged
worker_gid = 99
